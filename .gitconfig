[init]
	templatedir = ~/.git_template/template
	defaultBranch = main
[push]
  default = current
  autoSetupRemote = true
[pull]
  rebase = true
[color]
  ui = auto
[apply]
  whitespace = fix
[alias]
  aa = add --all
  ap = add --patch
  branches = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes
  co = checkout
  st = status
  a = add -p
  br = branch
  cia = commit --amend --no-edit
  co = checkout
  df = diff
  g = grep -I
  lf = log --pretty=format:'%Cred%h%Creset - %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  lg = log -p
  pp = !"echo 'Pull'; git pull; echo 'Push'; git put"
  put = push -u origin HEAD
  putf = push -u origin HEAD --force-with-lease
  ignore = update-index --assume-unchanged
  unignore = update-index --no-assume-unchanged
  ignored = !git ls-files -v | grep "^[[:lower:]]"
  cleanup = "!git branch --merged | grep  -v '\\*\\|master\\|main\\|develop' | xargs -n 1 git branch -d"
  sw = switch
  restore = restore
  graph = log --graph --oneline --decorate --all
[core]
  excludesfile = ~/.gitignore
  autocrlf = input
  editor = vim
[merge]
  ff = only
[commit]
  template = ~/.gitmessage
[fetch]
  prune = true
[rebase]
  autosquash = true
[color]
  ui = auto
  diff = auto
  status = auto
  branch = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[diff]
  colorMoved = default
  algorithm = histogram
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[merge]
  log = true
[user]
	name = Stephen Carr
	email = stephen.carr@introhive.com
# Credential helper is set conditionally based on OS
# macOS: Run `git config --global credential.helper osxkeychain`
# Linux: Run `git config --global credential.helper cache`
# Windows: Run `git config --global credential.helper manager-core`
