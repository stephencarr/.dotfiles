# Dotfiles Brewfile
# Install with: brew bundle --file=Brewfile

# Taps
tap "homebrew/cask"
tap "homebrew/cask-fonts"

# Core utilities
brew "git"
brew "git-delta"            # Better git diff
brew "vim"
brew "neovim"               # Modern vim alternative
brew "tmux"
brew "zsh"
brew "wget"
brew "curl"

# Shell enhancements
brew "starship"             # Modern cross-shell prompt
brew "zsh-autosuggestions"  # Fish-like autosuggestions
brew "zsh-syntax-highlighting"  # Syntax highlighting
brew "fzf"                  # Fuzzy finder
brew "ripgrep"              # Fast grep (rg)
brew "fd"                   # Fast find
brew "bat"                  # Cat with syntax highlighting
brew "eza"                  # Modern ls replacement (replaces exa)
brew "tree"                 # Directory tree
brew "zoxide"               # Smarter cd command
brew "atuin"                # Better shell history

# Development tools
brew "node"
brew "python"
brew "ruby"
brew "go"

# Version managers
brew "nvm"
brew "pyenv"
brew "rbenv"

# Database tools
brew "postgresql"
brew "mysql"
brew "redis"

# Image processing
brew "imagemagick"

# Useful tools
brew "htop"
brew "btop"                 # Better htop
brew "jq"                   # JSON processor
brew "yq"                   # YAML processor
brew "tldr"                 # Simplified man pages
brew "gnupg"
brew "direnv"               # Directory-specific env vars
brew "httpie"               # Better curl/wget
brew "trash"                # Safe rm alternative

# Git tools
brew "gh"                   # GitHub CLI
brew "tig"                  # Git interface
brew "lazygit"              # Terminal UI for git

# Fonts (Nerd Fonts with icons)
cask "font-fira-code-nerd-font"
cask "font-hack-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-meslo-lg-nerd-font"

